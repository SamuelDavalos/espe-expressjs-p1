              "pm.test('ADMIN lista reservas con 200', () => pm.response.to.have.status(200));",
              "const bookings = pm.response.json();",
              "const adminBooking = bookings.find((booking) => booking.user.role === 'ADMIN');",
              "if (adminBooking) { pm.environment.set('adminBookingId', String(adminBooking.id)); pm.environment.set('adminScheduleId', String(adminBooking.scheduleId)); pm.environment.set('adminBookingDate', adminBooking.date); }"
