{
  "info": {
    "_postman_id": "a4f19882-1048-46d6-b2dd-8f3a12d7fb65",
    "name": "EVAL_P1_Davalos",
    "description": "Colección de la Evaluación P1. Ejecutar en orden después de migrar y sembrar la base.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Servidor",
      "item": [
        { "name": "GET raíz", "request": { "method": "GET", "url": "{{baseUrl}}/" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));", "pm.test('Saludo de Express', () => pm.expect(pm.response.text()).to.eql('Hello World'));"], "type": "text/javascript" } }] }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        { "name": "POST register válido", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Usuario temporal de prueba\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"user123\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }, "event": [{ "listen": "prerequest", "script": { "exec": ["pm.environment.set('registerEmail', 'registro-' + Date.now() + '@example.test');"], "type": "text/javascript" } }, { "listen": "test", "script": { "exec": ["pm.test('Registro válido responde 201', () => pm.response.to.have.status(201));"], "type": "text/javascript" } }] },
        { "name": "POST register email duplicado", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{studentName}}\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"user123\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Correo duplicado responde 400', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }] },
        { "name": "POST register campos faltantes", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{studentEmail}}\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Campos faltantes responden 400', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }] },
        { "name": "POST register email inválido", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Prueba\",\n  \"email\": \"correo-invalido\",\n  \"password\": \"user123\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Email inválido responde 400', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }] },
        { "name": "POST login administrador", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login admin responde 200', () => pm.response.to.have.status(200));", "pm.environment.set('adminToken', pm.response.json().token);"], "type": "text/javascript" } }] },
        { "name": "POST login clave incorrecta", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"incorrecta\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Credenciales inválidas responden 400', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }] },
        { "name": "POST login estudiante", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login estudiante responde 200', () => pm.response.to.have.status(200));", "const token = pm.response.json().token;", "pm.environment.set('userToken', token);", "const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));", "pm.environment.set('studentId', String(payload.id));"], "type": "text/javascript" } }] },
        { "name": "GET protected route válido", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/api/auth/protected-route" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Token válido responde 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }] },
        { "name": "GET protected route sin token", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/protected-route" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Sin token responde 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }] },
        { "name": "GET protected route token inválido", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer token-invalido" }], "url": "{{baseUrl}}/api/auth/protected-route" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Token inválido responde 403', () => pm.response.to.have.status(403));"], "type": "text/javascript" } }] }
      ]
    },
    {
      "name": "Administración",
      "item": [
        { "name": "POST crear horario como ADMIN", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"court\": \"Pádel 3\",\n  \"startTime\": \"2026-11-24T08:00:00.000Z\",\n  \"endTime\": \"2026-11-24T10:00:00.000Z\"\n}" }, "url": "{{baseUrl}}/api/admin/schedules" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('ADMIN crea horario con 201', () => pm.response.to.have.status(201));", "pm.environment.set('testScheduleId', String(pm.response.json().id));"], "type": "text/javascript" } }] },
        { "name": "POST crear horario como USER", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"court\": \"Pádel 3\",\n  \"startTime\": \"2026-11-25T08:00:00.000Z\",\n  \"endTime\": \"2026-11-25T10:00:00.000Z\"\n}" }, "url": "{{baseUrl}}/api/admin/schedules" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('USER recibe 403', () => pm.response.to.have.status(403));"], "type": "text/javascript" } }] },
        { "name": "POST crear horario sin token", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"court\": \"Pádel 3\",\n  \"startTime\": \"2026-11-25T08:00:00.000Z\",\n  \"endTime\": \"2026-11-25T10:00:00.000Z\"\n}" }, "url": "{{baseUrl}}/api/admin/schedules" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Sin token recibe 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }] },
        { "name": "GET todas las reservas ADMIN", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/admin/bookings" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('ADMIN lista reservas con 200', () => pm.response.to.have.status(200));", "const bookings = pm.response.json();", "const adminBooking = bookings.find((booking) => booking.user.role === 'ADMIN');", "if (adminBooking) { pm.environment.set('adminBookingId', String(adminBooking.id)); pm.environment.set('adminScheduleId', String(adminBooking.scheduleId)); pm.environment.set('adminBookingDate', adminBooking.date); }"], "type": "text/javascript" } }] },
        { "name": "GET reservas ADMIN como USER", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/api/admin/bookings" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('USER recibe 403', () => pm.response.to.have.status(403));"], "type": "text/javascript" } }] },
        { "name": "GET reservas ADMIN sin token", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/bookings" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Sin token recibe 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }] }
      ]
    },
    {
      "name": "Reservas",
      "item": [
        { "name": "POST crear reserva", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"date\": \"2026-11-24T08:00:00.000Z\",\n  \"scheduleId\": {{testScheduleId}}\n}" }, "url": "{{baseUrl}}/api/bookings" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reserva creada con 201', () => pm.response.to.have.status(201));", "pm.environment.set('bookingId', String(pm.response.json().id));"], "type": "text/javascript" } }] },
        { "name": "POST crear reserva duplicada", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"date\": \"2026-11-24T08:00:00.000Z\",\n  \"scheduleId\": {{testScheduleId}}\n}" }, "url": "{{baseUrl}}/api/bookings" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Horario ocupado responde 400', () => pm.response.to.have.status(400));", "pm.test('Mensaje de conflicto', () => pm.expect(pm.response.json().message).to.eql('El horario ya está ocupado'));"], "type": "text/javascript" } }] },
        { "name": "POST crear reserva sin token", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"date\": \"2026-11-24T08:00:00.000Z\",\n  \"scheduleId\": {{testScheduleId}}\n}" }, "url": "{{baseUrl}}/api/bookings" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Sin token recibe 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }] },
        { "name": "GET reserva propia", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/api/bookings/{{bookingId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Dueño consulta con 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }] },
        { "name": "GET reserva inexistente", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/api/bookings/999999" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reserva inexistente responde 404', () => pm.response.to.have.status(404));"], "type": "text/javascript" } }] },
        { "name": "GET reserva ajena", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/api/bookings/{{adminBookingId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('No dueño recibe 403', () => pm.response.to.have.status(403));"], "type": "text/javascript" } }] },
        { "name": "PUT actualizar reserva propia", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"date\": \"2026-11-24T09:00:00.000Z\",\n  \"scheduleId\": {{testScheduleId}}\n}" }, "url": "{{baseUrl}}/api/bookings/{{bookingId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Actualización propia responde 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }] },
        { "name": "PUT actualizar a horario ocupado", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"date\": \"{{adminBookingDate}}\",\n  \"scheduleId\": {{adminScheduleId}}\n}" }, "url": "{{baseUrl}}/api/bookings/{{bookingId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Horario ocupado responde 400', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }] },
        { "name": "DELETE reserva propia", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/api/bookings/{{bookingId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Eliminación responde 204', () => pm.response.to.have.status(204));"], "type": "text/javascript" } }] },
        { "name": "DELETE reserva inexistente", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/api/bookings/999999" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reserva inexistente responde 404', () => pm.response.to.have.status(404));"], "type": "text/javascript" } }] },
        { "name": "GET historial propio", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/api/users/{{studentId}}/bookings" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Dueño consulta historial con 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }] },
        { "name": "GET historial ajeno", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/api/users/999999/bookings" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Historial ajeno responde 403', () => pm.response.to.have.status(403));"], "type": "text/javascript" } }] }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3099" },
    { "key": "adminEmail", "value": "paulo.galarza@example.com" },
    { "key": "adminPassword", "value": "" }
  ]
